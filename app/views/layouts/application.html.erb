<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

  <% if logged_in? %>
    <header style="background:#6f9aa0; padding:12px 16px;">
      <div style="max-width:960px; margin:0 auto; display:flex; align-items:center; gap:80px;">
        <div>
          <%= link_to root_path do %>
          <%= image_tag "logo.png", alt: "ロゴ", style: "height:40px;" %>
          <% end %>
        </div>

        <nav style="display:flex; gap:20px;">
          <%= link_to "修理", repairs_path,
              style: "color:#000; text-decoration:none;" %>

          <%= link_to "顧客", customers_path,
              style: "color:#000; text-decoration:none;" %>

          <%= link_to "代車", "#",
              style: "color:#000; text-decoration:none;" %>
        </nav>

        <div style="margin-left:auto;">
          <%= button_to "logout", logout_path,
              method: :delete,
              style: "background:#34675C; border:none; padding:8px 12px; border-radius:4px; cursor:pointer;" %>
        </div>
      </div>
    </header>
  <% end %>

  <div style="max-width:960px; margin:24px auto; padding:0 16px;">
    <%= yield %>
  </div>

</body>
