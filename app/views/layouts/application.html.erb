<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

  <% if logged_in? %>
    <header class="app-header">
      <div class="header-inner">
        <div>
          <%= link_to root_path do %>
          <%= image_tag "logo.png", alt: "ロゴ", style: "height:40px;" %>
          <% end %>
        </div>

        <nav style="display:flex; gap:20px;">
          <%= link_to "修理", repairs_path,
              style: "color:#000; text-decoration:none;" %>

          <%= link_to "顧客", customers_path,
              style: "color:#000; text-decoration:none;" %>

          <%= link_to "代車", loaner_cars_path,
              style: "color:#000; text-decoration:none;" %>
        </nav>

        <div class="logout">
          <%= button_to "logout", logout_path,
              method: :delete,
              class: "logout-btn" %>
        </div>
      </div>
    </header>
  <% end %>

  <div style="max-width:960px; margin:24px auto; padding:0 16px;">
    <%= yield %>
  </div>

</body>
