<div class="page-header">
  <div>
    <h1 class="page-title">修理一覧</h1>
  </div>
</div>

<div class="status-filter">
  <%= link_to repairs_path,
        class: "filter-btn #{'active' if @status_filter.nil?}" do %>
    すべて
    <span class="filter-count"><%= @counts[:all] %></span>
  <% end %>
  <%= link_to repairs_path(status: :reception),
        class: "filter-btn reception #{'active' if @status_filter == 'reception'}" do %>
    受付中
    <span class="filter-count"><%= @counts[:reception] %></span>
  <% end %>
  <%= link_to repairs_path(status: :working),
        class: "filter-btn working #{'active' if @status_filter == 'working'}" do %>
    作業中
    <span class="filter-count"><%= @counts[:working] %></span>
  <% end %>
  <%= link_to repairs_path(status: :completed),
        class: "filter-btn completed #{'active' if @status_filter == 'completed'}" do %>
    完了
    <span class="filter-count"><%= @counts[:completed] %></span>
  <% end %>
</div>

<table class="repair-table">
  <thead>
    <tr>
      <th>顧客名</th>
      <th>車両</th>
      <th>修理内容</th>
      <th>ステータス</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @repairs.each do |repair| %>
      <tr>
        <td><%= repair.car.customer.name %></td>
        <td>
          <%= repair.car.car_model %>
          (<%= repair.car.car_number %>)
        </td>
        <td><%= truncate(repair.description, length: 20) %></td>
        <td>
          <span class="status-badge <%= repair.status %>">
            <%= t("enums.repair.status.#{repair.status}") %>
          </span>
        </td>
        <td class="repair-actions">
          <% if repair.next_status %>
            <%= button_to repair.next_status_label,
                  update_status_repair_path(repair),
                  method: :patch,
                  params: { status: repair.next_status },
                  class: "btn-status-next btn-status-#{repair.next_status}" %>
          <% end %>
          <%= link_to "詳細", repair_path(repair), class: "btn-outline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @repairs %>
