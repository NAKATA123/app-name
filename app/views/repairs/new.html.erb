<h1>修理登録</h1>

<p>顧客名: <%= @car.customer.name %></p>
<p>車両: <%= @car.car_model %>（<%= @car.car_number %>）</p>

<%= form_with model: [@car, @repair] do |f| %>
  <div>
    <%= f.label :description, "修理内容" %><br>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :status, "ステータス" %><br>
    <%= f.select :status, Repair.statuses.keys %>
  </div>

  <%= f.submit "登録" %>
<% end %>
