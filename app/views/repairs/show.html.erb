<h1>修理詳細</h1>

<p>顧客名: <%= @repair.car.customer.name %></p>
<p>車両: <%= @repair.car.car_model %>（<%= @repair.car.car_number %>）</p>

<p>修理内容</p>
<p><%= @repair.description %></p>

<p>ステータス: <%= @repair.status_jp %></p>

<hr>

<%= link_to "代車を貸す", new_rental_path(repair_id: @repair.id) %>
<%= link_to "編集", edit_repair_path(@repair) %> |
<%= link_to "削除", repair_path(@repair),
            data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>

