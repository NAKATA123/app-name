<h1 class="page-title">修理編集</h1>

<div class="card" style="margin-bottom:20px;">
  <p><strong>顧客名:</strong> <%= @repair.car.customer.name %></p>
  <p>
    <strong>車両:</strong>
    <%= @repair.car.car_model %>（<%= @repair.car.car_number %>）
  </p>
</div>

<div class="card">
  <%= form_with model: @repair, local: true do |f| %>

    <div>
      <%= f.label :description, "修理内容", class: "form-label" %>
      <%= f.text_area :description, class: "form-textarea" %>
    </div>

    <div>
      <%= f.label :status, "ステータス", class: "form-label" %>
      <%= f.select :status,
        Repair.statuses.keys.map { |k| [t("enums.repair.status.#{k}"), k] },
        {},
        class: "form-select" %>
    </div>

    <div class="form-actions">
      <%= f.submit "更新する", class: "btn-primary" %>
      <%= link_to "戻る", repair_path(@repair), class: "btn-outline" %>
    </div>

  <% end %>
</div>
