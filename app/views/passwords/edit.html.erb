<div class="page-container" style="max-width:480px;">
  <h1 class="page-title">パスワード変更</h1>

  <div class="card">
    <%= form_with url: password_path, method: :patch, local: true do |f| %>

      <div>
        <%= label_tag :current_password, "現在のパスワード", class: "form-label" %>
        <%= password_field_tag :current_password, nil, class: "form-input", autocomplete: "current-password" %>
      </div>

      <div>
        <%= label_tag :password, "新しいパスワード", class: "form-label" %>
        <%= password_field_tag :password, nil, class: "form-input", autocomplete: "new-password" %>
      </div>

      <div>
        <%= label_tag :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
        <%= password_field_tag :password_confirmation, nil, class: "form-input", autocomplete: "new-password" %>
      </div>

      <div class="form-actions">
        <%= f.submit "変更する", class: "btn-primary" %>
        <%= link_to "キャンセル", root_path, class: "btn-outline" %>
      </div>

    <% end %>
  </div>
</div>
