<h1>代車一覧</h1>

<p>
  <%= link_to "代車を登録する", new_loaner_car_path %>
</p>

<table border="1" cellpadding="8">
  <tr>
    <th>名前</th>
    <th>ナンバー</th>
    <th>貸出履歴</th>
  </tr>

  <% @loaner_cars.each do |car| %>
    <tr>
      <td><%= car.name %></td>
      <td><%= car.car_number %></td>
      <td>
        <%= link_to "詳細", loaner_car_rentals_path(car) %>
      </td>
    </tr>
  <% end %>
</table>
