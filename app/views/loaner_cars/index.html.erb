<h1 class="page-title">代車一覧</h1>

<div style="margin: 20px 0;">
  <%= link_to "代車を登録する", new_loaner_car_path, class: "btn-primary" %>
</div>

<table class="repair-table">
  <tr>
    <th>名前</th>
    <th>ナンバー</th>
    <th>貸出履歴</th>
  </tr>

  <% @loaner_cars.each do |car| %>
    <tr>
      <td><%= car.name %></td>
      <td><%= car.car_number %></td>
      <td>
        <%= link_to "詳細", loaner_car_rentals_path(car), class: "btn-outline" %>
      </td>
    </tr>
  <% end %>
</table>

<hr style="margin: 40px 0; border: none; border-top: 1px solid #eee;">

<h2 class="section-title">貸出中</h2>

<% if @current_rentals.any? %>
  <table class="repair-table">
    <tr>
      <th>代車</th>
      <th>期間</th>
      <th>顧客</th>
    </tr>
    <% @current_rentals.each do |r| %>
      <tr>
        <td><%= r.loaner_car.name %></td>
        <td>
          <%= r.start_date.strftime("%Y/%m/%d") %>
          〜
          <%= r.end_date.strftime("%Y/%m/%d") %>
        </td>
        <td><%= r.repair.car.customer.name %></td>
      </tr>
    <% end %>
  </table>
<% else %>
  <p class="muted">現在貸出中の代車はありません。</p>
<% end %>

<h2 class="section-title">貸出予定</h2>

<% if @upcoming_rentals.any? %>
  <table class="repair-table">
    <tr>
      <th>代車</th>
      <th>期間</th>
      <th>顧客</th>
    </tr>
    <% @upcoming_rentals.each do |r| %>
      <tr>
        <td><%= r.loaner_car.name %></td>
        <td>
          <%= r.start_date.strftime("%Y/%m/%d") %>
          〜
          <%= r.end_date.strftime("%Y/%m/%d") %>
        </td>
        <td><%= r.repair.car.customer.name %></td>
      </tr>
    <% end %>
  </table>
<% else %>
  <p class="muted">貸出予定はありません。</p>
<% end %>
