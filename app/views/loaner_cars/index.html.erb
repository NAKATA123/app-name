<h1>代車一覧</h1>

<p>
  <%= link_to "代車を登録する", new_loaner_car_path %>
</p>

<table border="1" cellpadding="8">
  <tr>
    <th>名前</th>
    <th>ナンバー</th>
    <th>貸出履歴</th>
  </tr>

  <% @loaner_cars.each do |car| %>
    <tr>
      <td><%= car.name %></td>
      <td><%= car.car_number %></td>
      <td>
        <%= link_to "詳細", loaner_car_rentals_path(car) %>
      </td>
    </tr>
  <% end %>
</table>

<hr>

<h2>貸出中</h2>

<% if @current_rentals.any? %>
  <table class="table">
    <tr>
      <th>代車</th>
      <th>期間</th>
      <th>顧客</th>
    </tr>
    <% @current_rentals.each do |r| %>
      <tr>
        <td><%= r.loaner_car.name %></td>
        <td><%= r.start_date %> 〜 <%= r.end_date %></td>
        <td><%= r.repair.car.customer.name %></td>
      </tr>
    <% end %>
  </table>
<% else %>
  <p>現在貸出中の代車はありません。</p>
<% end %>

<h2>貸出予定</h2>

<% if @upcoming_rentals.any? %>
  <table class="table">
    <tr>
      <th>代車</th>
      <th>期間</th>
      <th>顧客</th>
    </tr>
    <% @upcoming_rentals.each do |r| %>
      <tr>
        <td><%= r.loaner_car.name %></td>
        <td><%= r.start_date %> 〜 <%= r.end_date %></td>
        <td><%= r.repair.car.customer.name %></td>
      </tr>
    <% end %>
  </table>
<% else %>
  <p>貸出予定はありません。</p>
<% end %>
