<div class="page-container">

  <div class="page-header">
    <div>
      <h1 class="page-title">車両登録</h1>
      <p class="muted">
        顧客名: <%= @customer.name %>
      </p>
    </div>
  </div>

  <div class="card">

    <%= form_with model: [@customer, @car] do |f| %>

      <div>
        <%= f.label :car_model, "車種", class: "form-label" %>
        <%= f.text_field :car_model, class: "form-input" %>
      </div>

      <div>
        <%= f.label :car_number, "ナンバー", class: "form-label" %>
        <%= f.text_field :car_number, class: "form-input" %>
      </div>

      <div style="margin-top: 20px;">
        <%= f.submit "登録する", class: "btn-primary" %>
      </div>

    <% end %>

  </div>

</div>
