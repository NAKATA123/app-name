<h1>車両詳細</h1>

<p>顧客名: <%= @car.customer.name %></p>
<p>車種: <%= @car.car_model %></p>
<p>ナンバー: <%= @car.car_number %></p>

<hr>

<%= link_to "＋修理追加",
            new_customer_car_repair_path(@car.customer, @car) %>

<%= link_to "編集",
            edit_customer_car_path(@car.customer, @car) %> |

<%= link_to "削除",
            customer_car_path(@car.customer, @car),
            data: { turbo_method: :delete,
                    turbo_confirm: "本当に削除しますか？" } %>
                    