<div class="page-container">

  <div class="page-header">
    <div>
      <h1 class="page-title">車両詳細</h1>
      <p class="muted">登録されている車両情報です</p>
    </div>

    <div class="page-actions">
      <%= link_to "＋ 修理追加",
          new_customer_car_repair_path(@car.customer, @car),
          class: "btn-primary" %>

      <%= link_to "編集",
          edit_customer_car_path(@car.customer, @car),
          class: "btn-outline" %>

      <%= link_to "顧客詳細へ戻る", customer_path(@car.customer), class: "btn-outline" %>
      <%= link_to "削除",
          customer_car_path(@car.customer, @car),
          class: "btn-danger",
          data: {
            turbo_method: :delete,
            turbo_confirm: "本当に削除しますか？"
          } %>
    </div>
  </div>

  <div class="card detail-card">
    <div class="detail-list">

      <div class="detail-row">
        <p class="detail-label">顧客名</p>
        <p class="detail-value"><%= @car.customer.name %></p>
      </div>

      <div class="detail-row">
        <p class="detail-label">車種</p>
        <p class="detail-value"><%= @car.car_model %></p>
      </div>

      <div class="detail-row">
        <p class="detail-label">ナンバー</p>
        <p class="detail-value"><%= @car.car_number %></p>
      </div>

      <div class="detail-row">
        <p class="detail-label">車検期限</p>
        <p class="detail-value">
          <% if @car.shaken_expiry_date %>
            <%= @car.shaken_expiry_date.strftime("%Y年%m月%d日") %>
            <% days = (@car.shaken_expiry_date - Time.zone.today).to_i %>
            <% if days < 0 %>
              <span class="shaken-badge shaken-expired">期限切れ</span>
            <% elsif days <= 30 %>
              <span class="shaken-badge shaken-soon">あと<%= days %>日</span>
            <% else %>
              <span class="shaken-badge shaken-warning">あと<%= days %>日</span>
            <% end %>
          <% else %>
            <span class="muted">未登録</span>
          <% end %>
        </p>
      </div>

    </div>
  </div>

</div>
