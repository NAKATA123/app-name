<h1 class="page-title page-title--img">
  <%= image_tag "icon_33-removebg-preview.png", alt: "", class: "title-car-img" %>
  ダッシュボード
</h1>

<div class="card" style="margin-bottom:24px;">
  <% today = Time.zone.today %>
  <% days_jp = %w[日 月 火 水 木 金 土] %>
  <p class="muted" style="margin:0;">本日</p>
  <p style="margin:6px 0 0; font-weight:800; font-size:16px;">
    <%= today.strftime("%Y/%m/%d") %>
    <span style="font-size:13px; color:#64748b; margin-left:4px;">
      （<%= days_jp[today.wday] %>）
    </span>
  </p>

  <div class="today-notice"
       data-controller="today-notice"
       data-today-notice-notice-id-value="<%= @today_notice.id || 0 %>"
       data-today-notice-notice-date-value="<%= @today_notice.notice_date %>"
       data-today-notice-create-url-value="<%= notices_path %>"
       data-today-notice-update-url-value="<%= @today_notice.persisted? ? notice_path(@today_notice) : "" %>">
    <div class="today-notice-header">
      <p class="today-notice-title">今日の連絡事項</p>
      <span class="today-notice-status" data-today-notice-target="status"></span>
    </div>
    <textarea class="today-notice-input"
              data-today-notice-target="input"
              data-action="input->today-notice#queueSave blur->today-notice#saveNow"
              placeholder="ここを押して入力"><%= @today_notice.content %></textarea>
  </div>
</div>

<% if @expiring_cars.any? %>
  <div class="shaken-alert">
    <div class="shaken-alert-header">
      <span class="shaken-alert-icon">⚠️</span>
      <span class="shaken-alert-title">車検期限のお知らせ</span>
      <span class="shaken-alert-count"><%= @expiring_cars.size %>件</span>
    </div>
    <ul class="shaken-alert-list">
      <% @expiring_cars.each do |car| %>
        <% days = (car.shaken_expiry_date - Time.zone.today).to_i %>
        <li class="shaken-alert-item">
          <%= link_to car.customer.name, customer_path(car.customer), class: "shaken-alert-name" %>
          <span class="shaken-alert-car"><%= car.car_model %>（<%= car.car_number %>）</span>
          <span class="shaken-alert-date"><%= car.shaken_expiry_date.strftime("%Y/%m/%d") %></span>
          <% if days < 0 %>
            <span class="shaken-badge shaken-expired">期限切れ</span>
          <% elsif days <= 30 %>
            <span class="shaken-badge shaken-soon">あと<%= days %>日</span>
          <% else %>
            <span class="shaken-badge shaken-warning">あと<%= days %>日</span>
          <% end %>
          <%= link_to "更新", edit_customer_car_path(car.customer, car, from: "dashboard"), class: "shaken-edit-btn" %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @expiring_loaner_cars.any? %>
  <div class="shaken-alert">
    <div class="shaken-alert-header">
      <span class="shaken-alert-icon">⚠️</span>
      <span class="shaken-alert-title">代車の車検期限のお知らせ</span>
      <span class="shaken-alert-count"><%= @expiring_loaner_cars.size %>件</span>
    </div>
    <ul class="shaken-alert-list">
      <% @expiring_loaner_cars.each do |car| %>
        <% days = (car.shaken_expiry_date - Time.zone.today).to_i %>
        <li class="shaken-alert-item">
          <span class="shaken-alert-name" style="color:#0f172a; text-decoration:none;">🚗 <%= car.name %></span>
          <span class="shaken-alert-car"><%= car.car_number %></span>
          <span class="shaken-alert-date"><%= car.shaken_expiry_date.strftime("%Y/%m/%d") %></span>
          <% if days < 0 %>
            <span class="shaken-badge shaken-expired">期限切れ</span>
          <% elsif days <= 30 %>
            <span class="shaken-badge shaken-soon">あと<%= days %>日</span>
          <% else %>
            <span class="shaken-badge shaken-warning">あと<%= days %>日</span>
          <% end %>
          <%= link_to "更新", edit_loaner_car_path(car), class: "shaken-edit-btn" %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<h2 class="section-title">修理状況</h2>
<div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:32px;">
  <%= link_to repairs_path(status: :reception), class: "card stat-card" do %>
    <p class="muted">受付中</p>
    <p class="stat-number"><%= @reception_count %></p>
  <% end %>

  <%= link_to repairs_path(status: :working), class: "card stat-card" do %>
    <p class="muted">作業中</p>
    <p class="stat-number"><%= @working_count %></p>
  <% end %>

  <%= link_to repairs_path(status: :completed), class: "card stat-card" do %>
    <p class="muted">完了</p>
    <p class="stat-number"><%= @completed_count %></p>
  <% end %>
</div>

<h2 class="section-title">代車状況</h2>
<div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:16px;">
  <div class="card">
    <p class="muted">貸出中</p>
    <p style="font-size:32px; font-weight:900;"><%= @loaned_count %></p>
  </div>

  <div class="card">
    <p class="muted">空き台数</p>
    <p style="font-size:32px; font-weight:900;"><%= @available_count %></p>
  </div>
</div>
