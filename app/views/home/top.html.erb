<header style="background:#6f9aa0; padding:12px 16px;">
  <div style="max-width:960px; margin:0 auto; display:flex; align-items:center; gap:16px;">
    <div style="font-weight:700;">ロゴ</div>

    <% if logged_in? %>
      <nav style="display:flex; gap:12px;">
        <%= link_to "修理", "#",
            style: "color:#000; text-decoration:none;" %>

        <%= link_to "顧客", customers_path,
            style: "color:#000; text-decoration:none;" %>

        <%= link_to "代車", "#",
            style: "color:#000; text-decoration:none;" %>
      </nav>
    <% end %>

    <div style="margin-left:auto;">
      <% if logged_in? %>
        <%= button_to "ログアウト", logout_path,
            method: :delete,
            style: "background:#39b9b5; border:none; padding:8px 12px; border-radius:4px; cursor:pointer;" %>
      <% end %>
    </div>
  </div>
</header>

<main style="max-width:960px; margin:24px auto; padding:0 16px;">
  <% if logged_in? %>
    <h1 style="text-align:center; margin:24px 0;">ダッシュボード</h1>

    <div style="display:flex; flex-direction:column; align-items:center; gap:16px;">
      <div style="width:360px; border:1px solid #bbb; padding:16px; background:#fff;">
        <h2 style="margin:0 0 8px; font-size:16px;">本日の修理状況</h2>
        <p style="margin:0;">受付中：0件 / 作業中：0件 / 完了：0件</p>
      </div>

      <div style="width:360px; border:1px solid #bbb; padding:16px; background:#fff;">
        <h2 style="margin:0 0 8px; font-size:16px;">代車の貸出状況</h2>
        <p style="margin:0;">貸出中：0台 / 空き：0台</p>
      </div>
    </div>
  <% else %>
    <h1 style="text-align:center; margin:24px 0;">ようこそ</h1>
    <p style="text-align:center;">
      ログインするとダッシュボードが表示されます
    </p>
  <% end %>
</main>
