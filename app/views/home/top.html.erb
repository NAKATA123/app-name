<main style="max-width:960px; margin:24px auto; padding:0 16px;">
  <% if logged_in? %>
    <h1 style="text-align:center; margin:24px 0;">ダッシュボード</h1>

    <div style="display:flex; flex-direction:column; align-items:center; gap:16px;">
      <div style="width:360px; border:1px solid #bbb; padding:16px; background:#fff;">
        <h2 style="margin:0 0 8px; font-size:16px;">本日の修理状況</h2>
        <p style="margin:0;">
          受付中：<%= @reception_count %>件 /
          作業中：<%= @working_count %>件 /
          完了：<%= @completed_count %>件
        </p>
      </div>

      <div style="width:360px; border:1px solid #bbb; padding:16px; background:#fff;">
        <h2 style="margin:0 0 8px; font-size:16px;">代車の貸出状況</h2>
        <p style="margin:0;">
          貸出中：<%= @loaned_count %>台 /
          空き：<%= @available_count %>台
        </p>
      </div>
    </div>
  <% else %>
    <h1 style="text-align:center; margin:24px 0;">ようこそ</h1>
    <p style="text-align:center;">
      ログインするとダッシュボードが表示されます
    </p>
  <% end %>
</main>
