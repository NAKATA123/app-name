<div class="page-container">
  <div class="page-header">
    <div>
      <h1 class="page-title">顧客詳細</h1>
      <p class="muted">顧客情報・登録車両・修理履歴を確認できます。</p>
    </div>

    <div class="page-actions">
      <%= link_to "編集", edit_customer_path(@customer), class: "btn-outline" %>
      <%= link_to "一覧へ戻る", customers_path, class: "btn-outline" %>
      <%= link_to "削除", customer_path(@customer),
            data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
            class: "btn-danger" %>
    </div>
  </div>

  <div class="card detail-card">
    <div class="detail-list">
      <div class="detail-row">
        <p class="detail-label">名前</p>
        <p class="detail-value"><%= @customer.name %></p>
      </div>

      <% if current_user.admin? %>
        <div class="detail-row">
          <p class="detail-label">電話番号</p>
          <p class="detail-value"><%= @customer.phone.presence || "未登録" %></p>
        </div>

        <div class="detail-row">
          <p class="detail-label">メール</p>
          <p class="detail-value"><%= @customer.email.presence || "未登録" %></p>
        </div>
      <% end %>

      <div class="detail-row">
        <p class="detail-label">メモ</p>
        <p class="detail-value"><%= @customer.notes.presence || "未登録" %></p>
      </div>
    </div>
  </div>

  <div class="section-block">
    <div class="page-header">
      <div>
        <h2 class="section-title">車両一覧</h2>
      </div>

      <div class="page-actions">
        <%= link_to "＋車両追加", new_customer_car_path(@customer), class: "btn-primary" %>
      </div>
    </div>

    <% if @customer.cars.any? %>
      <table class="repair-table">
        <thead>
          <tr>
            <th>車種</th>
            <th>車両番号</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @customer.cars.each do |car| %>
            <tr>
              <td><%= car.car_model %></td>
              <td><%= car.car_number %></td>
              <td>
                <%= link_to "詳細", customer_car_path(@customer, car), class: "btn-outline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="card empty-state">
        <p class="muted">車両はまだ登録されていません。</p>
      </div>
    <% end %>
  </div>

  <div class="section-block">
    <h2 class="section-title">修理一覧</h2>

    <% if @customer.repairs.any? %>
      <table class="repair-table">
        <thead>
          <tr>
            <th>車種</th>
            <th>車両番号</th>
            <th>ステータス</th>
          </tr>
        </thead>
        <tbody>
          <% @customer.repairs.each do |repair| %>
            <tr>
              <td><%= repair.car.car_model %></td>
              <td><%= repair.car.car_number %></td>
              <td>
                <span class="status-badge <%= repair.status %>">
                  <%= repair.status_jp %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="card empty-state">
        <p class="muted">修理履歴はまだありません。</p>
      </div>
    <% end %>
  </div>
</div>
