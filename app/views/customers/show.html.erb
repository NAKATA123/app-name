<h1>顧客詳細</h1>

<p>名前：<%= @customer.name %></p>
<p>電話番号：<%= @customer.phone %></p>
<p>メール：<%= @customer.email %></p>
<p>メモ：<%= @customer.notes %></p>

<%= link_to "編集", edit_customer_path(@customer) %> |
<%= link_to "一覧へ戻る", customers_path %> |
<%= link_to "削除", customers_path(@customer),
            data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
<hr>

<h2>修理一覧</h2>

<% if @customer.repairs.any? %>
  <% @customer.repairs.each do |repair| %>
    <p>
      <%= repair.car.car_model %>
      （<%= repair.car.car_number %>）
      |
      <span class="status-badge <%= repair.status %>">
        <%= repair.status_jp %>
      </span>
    </p>
  <% end %>
<% else %>
  <p>修理履歴なし</p>
<% end %>
