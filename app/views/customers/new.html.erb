<h1 class="page-title">顧客登録</h1>

<div class="card">
  <%= form_with model: @customer, local: true do |f| %>

    <div>
      <%= f.label :name, "名前", class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div>
      <%= f.label :phone, "電話番号", class: "form-label" %>
      <%= f.text_field :phone, class: "form-input" %>
    </div>

    <div>
      <%= f.label :email, "メール", class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div>
      <%= f.label :notes, "備考", class: "form-label" %>
      <%= f.text_area :notes, class: "form-textarea" %>
    </div>

    <div style="margin-top:20px;">
      <%= f.submit "登録する", class: "btn-primary" %>
    </div>

  <% end %>
</div>
