<h1>顧客登録</h1>

<%= form_with model: @customer do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :phone, "電話番号" %><br>
    <%= f.text_field :phone %>
  </div>

  <div>
    <%= f.label :email, "メール" %><br>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :notes, "備考" %><br>
    <%= f.text_area :notes %>
  </div>

  <div>
    <%= f.submit "登録する" %>
  </div>
<% end %>
