<div class="page-container">

  <div class="page-header">
    <div>
      <h1 class="page-title page-title--img">
        <%= image_tag "icon_31-removebg-preview.png", alt: "", class: "title-car-img" %>
        顧客一覧
      </h1>
      <p class="muted">登録されている顧客を確認できます。</p>
    </div>

    <div class="page-actions">
      <%= link_to "＋顧客登録", new_customer_path, class: "btn-primary" %>
    </div>
  </div>

  <%= search_form_for @q do |f| %>
    <div class="search-box">
      <%= f.search_field :name_cont,
          placeholder: "顧客名で検索" %>

      <%= f.submit "検索", class: "btn-primary" %>
    </div>
  <% end %>

  <% if @customers.any? %>
    <table class="repair-table">
      <thead>
        <tr>
          <th>名前</th>
          <% if current_user.admin? %>
            <th>電話番号</th>
            <th>メール</th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% @customers.each do |customer| %>
          <tr>
            <td class="cell-link">
              <%= link_to customer_path(customer), class: "cell-link-anchor" do %>
                <span><%= customer.name %></span>
              <% end %>
            </td>
            <% if current_user.admin? %>
              <td><%= customer.phone.presence || "-" %></td>
              <td><%= customer.email.presence || "-" %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= paginate @customers %>
  <% else %>
    <div class="card empty-state">
      <p class="muted">顧客はまだ登録されていません。</p>
    </div>
  <% end %>

</div>
