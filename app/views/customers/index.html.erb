<h1>顧客一覧</h1>

<p>
  <%= link_to "顧客を登録する", new_customer_path, class: "btn-primary" %>
</p>

<table class="repair-table">
  <tr>
    <th>名前</th>
    <th>電話番号</th>
    <th>メール</th>
  </tr>

  <% @customers.each do |customer| %>
    <tr>
      <td><%= link_to customer.name, customer_path(customer) %></td>
      <td><%= customer.phone %></td>
      <td><%= customer.email %></td>
    </tr>
  <% end %>
</table>
