<h1>顧客編集</h1>

<%= form_with model: @customer do |f| %>

  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :phone, "電話番号" %><br>
    <%= f.text_field :phone %>
  </div>

  <div>
    <%= f.label :email, "メール" %><br>
    <%= f.text_field :email %>
  </div>

  <div>
    <%= f.label :notes, "メモ" %><br>
    <%= f.text_area :notes %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>

<% end %>
