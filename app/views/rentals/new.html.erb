<h1>代車貸出登録</h1>

<%= form_with model: @rental do |f| %>

  <%= f.hidden_field :repair_id, value: @repair.id %>

  <div>
    <%= f.label :loaner_car_id, "代車選択" %><br>
    <%= f.collection_select :loaner_car_id, @loaner_cars, :id, :name %>
  </div>

  <div>
    <%= f.label :start_date, "開始日" %><br>
    <%= f.date_field :start_date %>
  </div>

  <div>
    <%= f.label :end_date, "終了日" %><br>
    <%= f.date_field :end_date %>
  </div>

  <div>
    <%= f.submit "貸出登録" %>
  </div>

<% end %>
