<h1>代車貸出登録</h1>

<% if @rental.errors.any? %>
  <div style="color: red; margin-bottom: 20px;">
    <ul>
      <% @rental.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @rental do |f| %>

  <%= f.hidden_field :repair_id, value: @repair.id %>

  <div>
    <%= f.label :loaner_car_id, "代車選択" %><br>
    <%= f.collection_select :loaner_car_id, @loaner_cars, :id, :name %>
  </div>

  <div>
    <%= f.label :start_date, "開始日" %><br>
    <%= f.date_field :start_date %>
  </div>

  <div>
    <%= f.label :end_date, "終了日" %><br>
    <%= f.date_field :end_date %>
  </div>

  <div style="margin-top: 15px;">
    <%= f.submit "貸出登録" %>
  </div>

<% end %>

<br>

<%= link_to "修理詳細に戻る", repair_path(@repair) %>
