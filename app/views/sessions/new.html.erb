<div class="login-page">
  <div class="login-card">
    <div class="login-header">
      <%= image_tag "logo.png", alt: "TOHSAKU", class: "login-logo" %>
      <h1>ログイン</h1>
      <p>おかえりなさい。TOHSAKUへログインします。</p>
    </div>

    <% if flash[:alert] %>
      <div class="login-alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post, class: "login-form" do |f| %>
      <div class="form-group">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, class: "form-input", placeholder: "example@email.com" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, class: "form-input", placeholder: "••••••••" %>
      </div>

      <div>
        <%= f.submit "ログイン", class: "btn-primary login-btn" %>
      </div>

    <% end %>
  </div>
</div>
