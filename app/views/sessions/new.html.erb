<div class="login-page">

  <!-- 左：デコレーションパネル -->
  <div class="login-deco">
    <div class="login-deco-inner">
      <div class="login-deco-car">🏎️</div>
      <div class="login-deco-brand">TOHSAKU</div>
      <p class="login-deco-tagline">車修理工場<br>業務管理システム</p>

      <div class="login-deco-flags">
        <span>🏁</span>
        <span>🏁</span>
        <span>🏁</span>
      </div>

      <div class="speed-lines">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
      </div>
    </div>

    <!-- タイヤ装飾 -->
    <div class="deco-tire deco-tire--tl"></div>
    <div class="deco-tire deco-tire--br"></div>
  </div>

  <!-- 右：フォームパネル -->
  <div class="login-panel">
    <div class="login-form-wrap">

      <div class="login-header">
        <%= image_tag "logo.png", alt: "TOHSAKU", class: "login-logo" %>
        <h1 class="login-title">ログイン</h1>
        <p class="login-subtitle">おかえりなさい 👋</p>
      </div>

      <% if flash[:alert] %>
        <div class="login-alert"><%= flash[:alert] %></div>
      <% end %>

      <%= form_with url: login_path, method: :post, class: "login-form" do |f| %>
        <div>
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, class: "form-input",
                placeholder: "example@email.com",
                autocomplete: "email" %>
        </div>

        <div>
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, class: "form-input",
                placeholder: "••••••••",
                autocomplete: "current-password" %>
        </div>

        <%= f.submit "ログイン ▶", class: "btn-primary login-btn" %>
      <% end %>

    </div>
  </div>

</div>
